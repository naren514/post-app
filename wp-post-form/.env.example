# WordPress target
WP_BASE_URL=https://example.com

# WordPress user (username or email)
WP_USERNAME=

# WordPress Application Password (NOT your normal password)
WP_APP_PASSWORD=

# Server bind
BIND_HOST=127.0.0.1
PORT=8787

# Optional: require a local access token to use the form
# If set, you must provide it as header X-Access-Token in requests.
ACCESS_TOKEN=
